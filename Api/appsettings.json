{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "DevOnly_ChangeThisJwtKey_AtLeast32Characters!",
    "Issuer": "ApiUsers",
    "Audience": "ApiUsersClient",
    "ExpireMinutes": 60
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "cocoa_sensory_lab_db",
    "Collections": {
      "Users": "users",
      "Tasks": "tasks"
    }
  }
}